# All optional; the build needs none of them.
NEXT_PUBLIC_SITE_URL=https://blacklakecap.com
# Defaults to the live GTM container (content/site.json). Loads on production only.
NEXT_PUBLIC_GTM_ID=
# Defaults to the live token (content/site.json).
GOOGLE_SITE_VERIFICATION=
# Dotted underline on unconfirmed values. Set to false at launch.
NEXT_PUBLIC_SHOW_REVIEW_FLAGS=true

# Contact form on /investors/. "log" (default) prints inquiries to the server log and sends nothing.
EMAIL_PROVIDER=log
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
