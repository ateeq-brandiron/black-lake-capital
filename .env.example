# All optional; the build needs none of them.
# Live site only (Hostinger): makes the site indexable and loads Tag Manager. Must be set at build time.
# Leave unset on Vercel staging and locally (noindex, no analytics).
SITE_ENV=
NEXT_PUBLIC_SITE_URL=https://blacklakecap.com
# Defaults to the live GTM container (content/site.json). Loads on production only.
NEXT_PUBLIC_GTM_ID=
# Defaults to the live token (content/site.json).
GOOGLE_SITE_VERIFICATION=
# Dotted underline on unconfirmed values. Set to false at launch.
NEXT_PUBLIC_SHOW_REVIEW_FLAGS=true

# Contact form on /investors/. "log" (default) prints inquiries to the server log and sends nothing.
# "activecampaign" or "resend" deliver them. Set these on the live host only, so staging never sends.
EMAIL_PROVIDER=log
# ActiveCampaign: Settings > Developer > API Access. List ID is the number after listid= in the list's URL.
# The tag is created if missing; an ActiveCampaign automation on "tag is added" alerts the team.
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_LIST_ID=
ACTIVECAMPAIGN_TAG=website-inquiry
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
